<Window x:Class="ISIP422_Vybornov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт товаров в магазине" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Список товаров">
            <DataGrid ItemsSource="{Binding Products}" 
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="60"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                    <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalValue, StringFormat=C}" Width="100"/>
                    <DataGridCheckBoxColumn Header="В наличии" Binding="{Binding IsAvailable}" Width="80"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="📊 Статистика" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding TotalProductsText}" Margin="3"/>
                        <TextBlock Text="{Binding TotalValueText}" Margin="3"/>
                        <TextBlock Text="{Binding AvailableProductsText}" Margin="3"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="🔍 Поиск товара" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Код:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SearchCode}" Height="25" 
                                         ToolTip="Введите код товара"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Название:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SearchName}" Height="25"
                                         ToolTip="Введите название товара"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Категория:" Margin="0,5,0,2"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SearchCategory}"
                                  Height="25" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Найти" 
                                    Command="{Binding SearchProductCommand}"
                                    Background="LightBlue"
                                    Margin="0,0,10,0"
                                    Width="80"
                                    Height="30"/>
                            <Button Content="Очистить" 
                                    Command="{Binding ClearSearchCommand}"
                                    Background="LightGray"
                                    Width="80"
                                    Height="30"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="➕ Добавить товар" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Название:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewProductName}" Height="25"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Цена:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewProductPrice}" Height="25"
                                         PreviewTextInput="NumberValidationTextBox"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Количество:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewProductQuantity}" Height="25"
                                         PreviewTextInput="IntegerValidationTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Категория:" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Categories}" 
                                          SelectedItem="{Binding NewProductCategory}"
                                          Height="25"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Добавить товар" 
                                Command="{Binding AddProductCommand}"
                                Background="LightGreen"
                                Height="30"
                                Margin="0,10,0,0"
                                FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="⚙️ Операции с товаром" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Border Background="LightBlue" Padding="5" CornerRadius="3" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Выбранный товар:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedProduct.Name, StringFormat='Название: {0}'}" 
                                           FontStyle="Italic"/>
                                <TextBlock Text="{Binding SelectedProduct.Quantity, StringFormat='Количество: {0}'}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="LightYellow" Padding="5" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="📦 Поставка" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding SupplyQuantity}" Margin="0,5,0,5" Height="25"
                                             ToolTip="Количество для поставки"
                                             PreviewTextInput="IntegerValidationTextBox"/>
                                    <Button Content="Заказать" 
                                            Command="{Binding SupplyProductCommand}"
                                            Background="Gold"
                                            Height="25"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="LightCoral" Padding="5" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="💰 Продажа" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding SellQuantity}" Margin="0,5,0,5" Height="25"
                                             ToolTip="Количество для продажи"
                                             PreviewTextInput="IntegerValidationTextBox"/>
                                    <Button Content="Продать" 
                                            Command="{Binding SellProductCommand}"
                                            Background="OrangeRed"
                                            Foreground="White"
                                            Height="25"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Content="🗑️ Удалить товар" 
                                Command="{Binding RemoveProductCommand}"
                                Background="DarkRed"
                                Foreground="White"
                                Height="30"
                                FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>